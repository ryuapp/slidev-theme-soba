{
  "name": "slidev-theme-soba",
  "version": "0.2.4",
  "description": "A simple Slidev theme for Japanese",
  "license": "MIT",
  "type": "module",
  "repository": "ryuapp/slidev-theme-soba",
  "homepage": "https://github.com/ryuapp/slidev-theme-soba",
  "bugs": "https://github.com/ryuapp/slidev-theme-soba/issues",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "slidev": {
    "colorSchema": "light",
    "highlighter": "shiki",
    "defaults": {
      "fonts": {
        "sans": [
          "Poppins",
          "Noto Sans JP"
        ],
        "serif": "Roboto Slab",
        "mono": "Fira Code",
        "weights": [
          200,
          400,
          500,
          700
        ]
      },
      "hightlighter": "shiki"
    }
  },
  "files": [
    "components",
    "layouts",
    "setup",
    "styles",
    "global-bottom.vue"
  ],
  "devDependencies": {
    "@slidev/cli": "52.15.2",
    "@slidev/types": "52.15.2",
    "playwright-chromium": "1.60.0"
  },
  "engines": {
    "node": ">=22.22.0",
    "slidev": ">=52.0.0"
  }
}
